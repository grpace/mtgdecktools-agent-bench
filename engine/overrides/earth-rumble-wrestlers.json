                },
                "filter": {
                  "type": "Typed",
                  "type_filters": [
                    "Land"
                  ],
                  "controller": null,
                  "properties": []
                }
              }
            },
            "comparator": "GE",
            "rhs": {
              "type": "Fixed",
              "value": 1
            }
          }
        ]
      }
    }
  ],
