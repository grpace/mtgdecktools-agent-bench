  "title": "the flashback bonus (+1/+1 counters for every three cards in your graveyard) does nothing",
  "status": "active",
  "kind": "parser",
  "upstream_issue": "https://github.com/phase-rs/phase/pull/10219",
  "marks_supported": true,
  "applies_to": {
    "server_version": "0.117.0",
    "build_commit": "09c286c",
