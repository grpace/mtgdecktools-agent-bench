  "card": "Mirrormind Crown",
  "title": "the token-copy replacement is parsed as an unimplemented spell ability, so it never applies",
  "status": "active",
  "kind": "parser",
  "upstream_issue": "https://github.com/phase-rs/phase/issues/7736",
  "marks_supported": true,
