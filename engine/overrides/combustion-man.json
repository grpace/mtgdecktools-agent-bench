      "path": "/triggers/0/execute/effect",
      "value": {
        "type": "Unimplemented",
        "name": "Unsupported unless clause",
        "description": "destroy target permanent unless its controller has ~ deal damage to them equal to his power (unless: its controller has ~ deal damage to them equal to his power)"
