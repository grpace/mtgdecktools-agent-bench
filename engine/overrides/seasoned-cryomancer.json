{
  "card": "Seasoned Cryomancer",
  "title": "discarding nonland cards to its enters trigger never taps or stuns anything",
  "status": "active",
  "kind": "parser",
  "upstream_issue": null,
  "marks_supported": true,
  "applies_to": {
    "server_version": "0.117.0",
    "build_commit": "09c286c",
    "card_data_sha256": "84d5fd2af84e2f125b740eeb05637785b2e8df26d34e41a2cd628697dae30513",
