{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grpace/mtgdecktools-agent-bench/registry/schema/models.schema.json",
  "title": "MTG Deck Tools Agent Benchmark: model registry",
  "description": "Canonical model ids, display names, aliases, effort support and per-harness launch strings. See registry/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers",
    "effort_scale",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display",
          "prefixes"
        ],
        "properties": {
          "display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "prefixes": {
            "description": "Prefixes harnesses and gateways put in front of this provider's model ids (\"anthropic/\", \"openai/\"). Stripped before matching.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+[/.]$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "effort_scale": {
      "description": "The canonical effort scale every harness's reasoning setting maps onto (docs: registry/README.md, Effort).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display",
          "rank",
          "aliases"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/effort"
          },
          "display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "uniqueItems": true
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra",
        "default",
        "unknown"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "modelId": {
      "description": "Exactly the provider's API model id: lowercase letters, digits, dots and dashes.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,79}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "provider",
        "family",
        "status",
        "source",
        "aliases",
        "floating_aliases",
        "snapshots",
        "efforts",
        "launch"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/modelId"
        },
        "display": {
          "description": "The exact product name (\"Claude Sonnet 5.5\").",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "provider": {
          "$ref": "#/$defs/slug"
        },
        "family": {
          "$ref": "#/$defs/slug"
        },
        "released": {
          "description": "Release date from an official page (the provider's changelog, announcement or model page). Leave it out when no official page gives one; never take it from a third-party site.",
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "active",
            "preview",
            "deprecated",
            "retired"
          ]
        },
        "deprecated": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "description": "Official page that lists this exact id.",
          "type": "string",
          "pattern": "^https://"
        },
        "aliases": {
          "description": "Other spellings that always mean this model: short names, common display spellings. Case, spaces, dots and dashes never matter (they are ignored when matching); provider prefixes are stripped automatically.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "uniqueItems": true
        },
        "floating_aliases": {
          "description": "Names that point at the newest model of a line and move when a new one ships (Claude Code's \"sonnet\"). Each covers a date window; the event's start date picks the model.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "from"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              "from": {
                "$ref": "#/$defs/date"
              },
              "until": {
                "description": "Exclusive end date (the day the successor took the alias).",
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "snapshots": {
          "description": "Known dated snapshot ids behind this canonical id (\"claude-haiku-4-5-20251001\"). Snapshots share the canonical id's leaderboard row; the export records and flags which snapshot played.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelId"
          },
          "uniqueItems": true
        },
        "efforts": {
          "description": "Canonical efforts the model supports. Empty: no effort setting (seats record \"default\").",
          "type": "array",
          "items": {
            "$ref": "#/$defs/effort"
          },
          "uniqueItems": true
        },
        "default_effort": {
          "description": "The provider API's default when no effort is sent (informational: harness defaults can differ).",
          "$ref": "#/$defs/effort"
        },
        "launch": {
          "description": "What to pass as the model to each harness (harness id → string). `{effort}` in the string stands for the harness's word for the level (Cursor's model names carry it). Leave a harness out when its docs or its model list don't confirm the string.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "launch_effort_words": {
          "description": "Where a harness spells a level differently for this model in its launch string (Cursor's gpt-5.5-extra-high): harness id → canonical level → the word in the string.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
